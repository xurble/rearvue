# Copy to /etc/rearvue/rearvue.env, restrict it to the RearVue service account,
# and replace every required or deployment-specific value.

REARVUE_SECRET_KEY=
REARVUE_ALLOWED_HOSTS=archive.example.com
REARVUE_DEBUG=false

REARVUE_DB_NAME=rearvue
REARVUE_DB_USER=rearvue
REARVUE_DB_PASSWORD=
REARVUE_DB_HOST=127.0.0.1
REARVUE_DB_PORT=3306
# Keep this at zero for ASGI; use a backend-supported pool for connection reuse.
REARVUE_DB_CONN_MAX_AGE=0

REARVUE_DEPLOY_ROOT=/srv/rearvue
REARVUE_DATA_STORE=/srv/rearvue/data
REARVUE_LOG_LOCATION=/srv/rearvue/logs/rearvue.log
REARVUE_STATIC_ROOT=/srv/rearvue/static
REARVUE_MEDIA_ROOT=/srv/rearvue/media

REARVUE_MCP_ENABLED=false
REARVUE_MCP_ALLOWED_HOSTS=archive.example.com
REARVUE_MCP_ALLOWED_ORIGINS=
REARVUE_MCP_DEFAULT_PAGE_SIZE=50
REARVUE_MCP_MAX_PAGE_SIZE=100
REARVUE_MCP_MAX_BULK_ITEMS=100
REARVUE_MCP_MAX_RAW_DATA_BYTES=262144
REARVUE_MCP_MAX_REQUEST_BODY_BYTES=2097152
REARVUE_MCP_IDEMPOTENCY_TTL_SECONDS=86400

REARVUE_BIND=127.0.0.1:8000
# Set this after measuring CPU, database connection capacity, and workload.
REARVUE_WORKERS=3
REARVUE_WORKER_TIMEOUT=120
REARVUE_GRACEFUL_TIMEOUT=30
REARVUE_KEEPALIVE=5
REARVUE_MAX_REQUESTS=1000
REARVUE_MAX_REQUESTS_JITTER=100
REARVUE_FORWARDED_ALLOW_IPS=127.0.0.1,::1

FLICKR_KEY=
FLICKR_SECRET=
INSTAGRAM_KEY=
INSTAGRAM_SECRET=
FEEDS_SERVER=
